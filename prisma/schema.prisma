// DesStudy — data model (PRD Ch.5 / §7 Progress Tracking).
// Postgres (Neon / Vercel Postgres) — serverless-friendly; SQLite can't persist
// on Vercel's read-only, ephemeral filesystem. Mirrors src/lib/curriculum/types.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// An anonymous or (later) authenticated learner. Identified by a cookie for now.
model Learner {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Gamification / retention (PRD §8, §13)
  xp           Int      @default(0)
  streak       Int      @default(0)
  lastActiveOn String? // ISO date (YYYY-MM-DD) for streak calculation

  attempts    Attempt[]
  progress    LessonProgress[]
  skills      SkillStat[]
  submissions Submission[]
}

/// One recorded attempt at one exercise (PRD §7: Attempts, Average Score).
model Attempt {
  id         String   @id @default(cuid())
  learner    Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  learnerId  String
  lessonSlug String
  exerciseId String
  skill      String // e.g. "spacing" — powers weak-skill analytics
  correct    Boolean
  tries      Int // attempts taken before solving this exercise
  createdAt  DateTime @default(now())

  @@index([learnerId, skill])
}

/// Per-lesson completion state (PRD §7: Lessons, Modules, Courses).
model LessonProgress {
  learner       Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  learnerId     String
  lessonSlug    String
  completed     Boolean  @default(false)
  solvedCount   Int      @default(0)
  totalCount    Int
  updatedAt     DateTime @updatedAt

  @@id([learnerId, lessonSlug])
}

/// Rolling per-skill accuracy → drives weak/strong skills + adaptive difficulty (PRD §4, §7).
model SkillStat {
  learner      Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  learnerId    String
  skill        String
  solved       Int     @default(0)
  totalTries   Int     @default(0)

  @@id([learnerId, skill])
}

/// A figma-link/file-upload submission awaiting human/mentor review — these
/// exercise types can't be auto-graded (PRD note: no vision model in scope).
model Submission {
  id         String   @id @default(cuid())
  learner    Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  learnerId  String
  lessonSlug String
  exerciseId String
  kind       String // 'figma-link' | 'file-upload'
  value      String // the Figma URL, or the stored file's public path
  createdAt  DateTime @default(now())

  @@index([learnerId, lessonSlug])
}

/// A teacher-authored lesson (Admin panel, no auth gate yet — see requireAdmin()
/// in src/lib/admin.ts). Mirrors src/lib/curriculum/types.ts's `Lesson` shape;
/// once `published`, it's merged alongside the static src/content lessons for
/// learners at read time (src/content/lessons/index.ts).
model AuthoredLesson {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  pathTitle        String // free-text grouping label shown on /learn
  skill            String
  difficulty       String // Difficulty: 'intro' | 'easy' | 'medium' | 'hard'
  estimatedMinutes Int
  objectives       String // JSON string[] — see src/lib/admin/schema.ts
  prerequisites    String // JSON string[]
  published        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  blocks ContentBlock[]
}

/// One ordered block inside an AuthoredLesson — theory line, video, or
/// exercise. `payload` is a JSON string validated against the matching zod
/// schema in src/lib/admin/schema.ts before every write (SQLite has no native
/// JSON column in Prisma, and we want ONE source of truth for the shape:
/// src/lib/curriculum/types.ts, not a duplicated Prisma model per exercise type).
/// For `kind: 'exercise'`, the LAST such block (by `order`) becomes the
/// lesson's masteryChallenge; the rest become `exercises[]` — no separate
/// "is this the mastery one" flag to manage in the builder UI.
model ContentBlock {
  id       String         @id @default(cuid())
  lesson   AuthoredLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId String
  order    Int
  kind     String // 'theory' | 'video' | 'exercise'
  payload  String // JSON — shape depends on `kind`

  @@index([lessonId, order])
}
