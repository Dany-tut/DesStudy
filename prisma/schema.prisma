// DesStudy — data model (PRD Ch.5 / §7 Progress Tracking).
// Postgres (Neon / Vercel Postgres) — serverless-friendly; SQLite can't persist
// on Vercel's read-only, ephemeral filesystem. Mirrors src/lib/curriculum/types.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection for the serverless runtime; direct connection for
  // migrations (prisma migrate deploy). Vercel's Postgres/Neon integration
  // injects both env vars automatically.
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

/// Staff roles. BOSS = platform creator (single, seeded from env); TEACHER =
/// invited educator who authors lessons/assignments for their own learners.
/// Learners are NOT Users — they stay cookie-anonymous (see src/lib/learner.ts).
enum Role {
  BOSS
  TEACHER
}

/// An authenticated staff member (boss or teacher). Email + password credentials
/// (bcrypt hash); session is a signed JWT cookie — see src/lib/auth/. Distinct
/// from Learner on purpose: staff log in, learners are anonymous by cookie.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(TEACHER)
  createdAt    DateTime @default(now())

  invitesCreated Invite[] @relation("InvitesCreated")
  inviteUsed     Invite?  @relation("InviteUsed")
}

/// A single-use registration link the boss (or a teacher, later) hands out.
/// Consuming it creates a User with this `role`. Optional `email` pins the
/// invite to one address; optional `expiresAt` time-limits it.
model Invite {
  id          String    @id @default(cuid())
  token       String    @unique
  role        Role      @default(TEACHER)
  email       String? // optional: restrict/pre-fill the registrant's email
  createdBy   User      @relation("InvitesCreated", fields: [createdById], references: [id], onDelete: Cascade)
  createdById String
  usedBy      User?     @relation("InviteUsed", fields: [usedById], references: [id], onDelete: SetNull)
  usedById    String?   @unique
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([createdById])
}

/// An anonymous or (later) authenticated learner. Identified by a cookie for now.
model Learner {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // ФИ — captured on the first step of the entry assessment (grading test).
  // Null until the learner introduces themselves; "letit prepodu" via /admin/results.
  name String?

  // Gamification / retention (PRD §8, §13)
  xp           Int      @default(0)
  streak       Int      @default(0)
  lastActiveOn String? // ISO date (YYYY-MM-DD) for streak calculation

  attempts    Attempt[]
  progress    LessonProgress[]
  skills      SkillStat[]
  submissions Submission[]
  assessments Assessment[]
  enrollments Enrollment[]
}

/// A purchasable course. Seeded manually for the MVP (no course-authoring UI yet);
/// the teacher attaches one to a learner via Enrollment to track their progress.
model Course {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  createdAt DateTime @default(now())

  enrollments Enrollment[]
}

/// Teacher-assigned link between a learner and a course they bought.
model Enrollment {
  learner   Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  learnerId String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId  String
  createdAt DateTime @default(now())

  @@id([learnerId, courseId])
}

/// One completed run of the entry grading test. Per-skill levels and category
/// grades are stored as JSON strings (same pattern as ContentBlock.payload) so
/// the 25-skill taxonomy lives in one place — src/lib/assessment/taxonomy.ts —
/// not as columns to migrate on every taxonomy tweak.
model Assessment {
  id             String   @id @default(cuid())
  learner        Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  learnerId      String
  grade          String // 'junior' | 'middle' | 'senior'
  scores         String // JSON: Record<skillId, 1..4>
  categoryGrades String // JSON: Record<category, { grade, avg }>
  createdAt      DateTime @default(now())

  @@index([learnerId])
}

/// One recorded attempt at one exercise (PRD §7: Attempts, Average Score).
model Attempt {
  id         String   @id @default(cuid())
  learner    Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  learnerId  String
  lessonSlug String
  exerciseId String
  skill      String // e.g. "spacing" — powers weak-skill analytics
  correct    Boolean
  tries      Int // attempts taken before solving this exercise
  createdAt  DateTime @default(now())

  @@index([learnerId, skill])
}

/// Per-lesson completion state (PRD §7: Lessons, Modules, Courses).
model LessonProgress {
  learner       Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  learnerId     String
  lessonSlug    String
  completed     Boolean  @default(false)
  solvedCount   Int      @default(0)
  totalCount    Int
  updatedAt     DateTime @updatedAt

  @@id([learnerId, lessonSlug])
}

/// Rolling per-skill accuracy → drives weak/strong skills + adaptive difficulty (PRD §4, §7).
model SkillStat {
  learner      Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  learnerId    String
  skill        String
  solved       Int     @default(0)
  totalTries   Int     @default(0)

  @@id([learnerId, skill])
}

/// A figma-link/file-upload submission awaiting human/mentor review — these
/// exercise types can't be auto-graded (PRD note: no vision model in scope).
model Submission {
  id         String   @id @default(cuid())
  learner    Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  learnerId  String
  lessonSlug String
  exerciseId String
  kind       String // 'figma-link' | 'file-upload'
  value      String // the Figma URL, or the stored file's public path
  createdAt  DateTime @default(now())

  @@index([learnerId, lessonSlug])
}

/// A teacher-authored lesson (Admin panel, no auth gate yet — see requireAdmin()
/// in src/lib/admin.ts). Mirrors src/lib/curriculum/types.ts's `Lesson` shape;
/// once `published`, it's merged alongside the static src/content lessons for
/// learners at read time (src/content/lessons/index.ts).
model AuthoredLesson {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  pathTitle        String // free-text grouping label shown on /learn
  skill            String
  difficulty       String // Difficulty: 'intro' | 'easy' | 'medium' | 'hard'
  estimatedMinutes Int
  objectives       String // JSON string[] — see src/lib/admin/schema.ts
  prerequisites    String // JSON string[]
  published        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  blocks ContentBlock[]
}

/// One ordered block inside an AuthoredLesson — theory line, video, or
/// exercise. `payload` is a JSON string validated against the matching zod
/// schema in src/lib/admin/schema.ts before every write (SQLite has no native
/// JSON column in Prisma, and we want ONE source of truth for the shape:
/// src/lib/curriculum/types.ts, not a duplicated Prisma model per exercise type).
/// For `kind: 'exercise'`, the LAST such block (by `order`) becomes the
/// lesson's masteryChallenge; the rest become `exercises[]` — no separate
/// "is this the mastery one" flag to manage in the builder UI.
model ContentBlock {
  id       String         @id @default(cuid())
  lesson   AuthoredLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId String
  order    Int
  kind     String // 'theory' | 'video' | 'exercise'
  payload  String // JSON — shape depends on `kind`

  @@index([lessonId, order])
}
